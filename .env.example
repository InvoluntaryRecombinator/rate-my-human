# Supabase connection strings — in the Supabase dashboard click Connect > ORM > Prisma to get these.
# DATABASE_URL = pooled connection (Supavisor transaction mode, port 6543) — used by the app at runtime
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL = session pooler (port 5432) — used by Prisma CLI for migrations
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"
PORT=3001
